# Copie para .env.local (não versionado). Na Vercel: `npm run vercel:env` configura as
# obrigatórias (ou Settings → Environment Variables).
# Atenção: `vercel env pull` sem nome de arquivo SOBRESCREVE o .env.local.
#
# ── Servidor (BFF em api/) ───────────────────────────────────────────────────
# Estas variáveis NÃO têm prefixo VITE_: ficam só no servidor e nunca vão para o navegador.

# URL do MOVT-BACKEND (HTTPS obrigatório; HTTP só para localhost fora da Vercel)
UPSTREAM_API_URL=https://movt-backend.vercel.app/api
# Ex. backend local:
# UPSTREAM_API_URL=http://localhost:3000/api

# Chave AES-256 que cifra o cookie de sessão (32 bytes em base64). Obrigatória na Vercel.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BFF_SESSION_KEY=

# Segredo compartilhado com o MOVT-BACKEND para assinar o IP real do usuário
# (mesmo valor nos dois projetos, >= 32 caracteres). Obrigatório na Vercel.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BFF_PROXY_SECRET=

# Origens extras aceitas em requisições que alteram dados (opcional, separadas por vírgula).
# O próprio domínio do site já é aceito automaticamente.
# ALLOWED_ORIGINS=https://www.movt.app

# Rate limit global entre instâncias (opcional). Sem isto, o limite é em memória.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Navegador (vão para o bundle público: NUNCA coloque segredos aqui) ───────
# URL pública do site (canonical e Open Graph)
VITE_SITE_URL=https://movt.app

# Copie para .env.local (não versionado) para sobrescrever localmente.
# Todas as variáveis VITE_* vão para o bundle do navegador: NUNCA coloque segredos aqui.

# URL base da API (obrigatoriamente HTTPS em produção; HTTP só para localhost no `npm run dev`)
VITE_API_URL=https://movt-backend.vercel.app/api
# Ex. backend local:
# VITE_API_URL=http://localhost:3000/api

# URL pública do site (canonical e Open Graph)
VITE_SITE_URL=https://movt.app
